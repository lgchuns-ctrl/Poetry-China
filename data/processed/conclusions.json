[{"conclusion_id": "c_001", "text": "在当前数据集中，「长安」是被诗词书写次数最多的地点，共被提及413次。", "metric": "place_mention_count", "value": 413, "dataset_version": "1.0", "generated_at": "2026-08-14T09:19:43.856481"}, {"conclusion_id": "c_002", "text": "在所有城市中，「长安」是诗词书写频率最高的城市，共413次。", "metric": "city_mention_count", "value": 413, "dataset_version": "1.0", "generated_at": "2026-08-14T09:19:43.856513"}, {"conclusion_id": "c_003", "text": "在山岳类地点中，「巫山」是被书写最多的山，共121次。", "metric": "mountain_mention_count", "value": 121, "dataset_version": "1.0", "generated_at": "2026-08-14T09:19:43.856516"}, {"conclusion_id": "c_004", "text": "唐诗中提及频率最高的是「洛阳」（305次），宋词中最高的是「江南」（254次）。", "metric": "dynasty_top_place", "value": {"tang": 305, "song": 254}, "dataset_version": "1.0", "generated_at": "2026-08-14T09:19:43.856535"}, {"conclusion_id": "c_005", "text": "「风」是出现频率最高的意象，出现在7590首作品中。", "metric": "imagery_frequency", "value": 7590, "dataset_version": "1.0", "generated_at": "2026-08-14T09:19:43.856540"}, {"conclusion_id": "c_006", "text": "「山水」是最常见的主题，共5366首作品涉及。", "metric": "theme_frequency", "value": 5366, "dataset_version": "1.0", "generated_at": "2026-08-14T09:19:43.856548"}, {"conclusion_id": "c_007", "text": "在作品数≥5的诗人中，「杜甫」的文学地理覆盖最广，涉及86个不同地点。", "metric": "author_place_diversity", "value": 86, "dataset_version": "1.0", "generated_at": "2026-08-14T09:19:43.856554"}, {"conclusion_id": "c_008", "text": "本数据集收录15008首唐诗和6000首宋词，覆盖1141位诗人，提取190个文学地点，共5341次地名提及。", "metric": "dataset_overview", "value": {"total_works": 21008, "tang_poems": 15008, "song_ci": 6000, "total_authors": 1141, "total_places": 190, "total_mentions": 5341}, "dataset_version": "1.0", "generated_at": "2026-08-14T09:19:43.856558"}]